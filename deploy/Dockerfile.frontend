## Immutable production gateway image: Vite asset build + hardened TLS nginx.
## Built from the repository root:
##   docker build -f deploy/Dockerfile.frontend -t rd-alpha-frontend:local .

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /src/frontend

COPY frontend/package*.json ./
# The lockfile contains a Vitest peer range that npm 10 rejects despite the
# resolved package set being deterministic. Match the verified CI install
# behavior rather than allowing the production image to use npm install.
RUN npm ci --legacy-peer-deps

COPY frontend/ ./
ENV VITE_API_URL=""
RUN npm run build


FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# The official Nginx entrypoint renders only PUBLIC_HOSTNAME at container
# startup. Restricting envsubst avoids expanding Nginx's own $host/$request_uri
# variables while allowing staging and production to use distinct domains.
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /src/frontend/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
