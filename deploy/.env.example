# Copy to /etc/rd-alpha/prod.env on the target host. Never commit the
# populated file or place it inside a versioned release directory. The
# host-side GitLab release agent supplies BACKEND_IMAGE and FRONTEND_IMAGE.

POSTGRES_PASSWORD=replace-with-a-long-unique-password
# Same internal DSN with the password percent-encoded. For example:
# python3 -c 'import os,urllib.parse; print(urllib.parse.quote(os.environ["POSTGRES_PASSWORD"], safe=""))'
BACKEND_DATABASE_URL=postgresql+asyncpg://postgres:replace-with-url-encoded-password@postgres:5432/rd_alpha
SECRET_KEY=replace-with-at-least-32-random-characters
# Fail-closed rank enrich audits. Use 1 on staging; 0 (or omit) on production
# until live quote coverage matches the sealed golden fixture.
RANK_INVARIANT_FAIL_CLOSED=1
SEC_USER_AGENT=Finsoeasy Research ops@example.com
# Set these explicitly and differently in staging and production; deployment
# intentionally has no public-domain fallback.
PUBLIC_HOSTNAME=staging.example.com
AUTH_RESET_URL=https://staging.example.com/reset-password
AUTH_VERIFY_URL=https://staging.example.com/verify-email
STRIPE_SUCCESS_URL=https://staging.example.com/donate?success=true
STRIPE_CANCEL_URL=https://staging.example.com/donate?canceled=true

# Set both values together when Redis authentication is enabled.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Data providers / infrastructure
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
AWS_REGION=us-east-1
S3_BUCKET=fse-rnd-alpha-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Immutable artifact produced by scripts/stage_data_release.sh. Deployment
# restores and verifies this before applying migrations or starting the app.
DATA_DIR=/opt/rd-alpha-data
CERTS_DIR=/opt/rd-alpha-certs
CERTBOT_WEBROOT=/opt/rd-alpha-certbot-webroot
# Must name the Object-Lock-enabled bucket used by stage_data_release.sh.
# Defaults to S3_BUCKET only when both provider data and releases share it.
DATA_RELEASE_BUCKET=
DATA_RELEASE_PREFIX=investor-platform-data
DATA_RELEASE_URI=s3://replace-with-versioned-bucket/investor-platform-data/univ_x/manifest_sha
# SHA-256 of that prefix's release.json. This binds archive, snapshot, and
# research-record checksums—not merely the data manifest—to the promotion.
DATA_RELEASE_DESCRIPTOR_SHA256=
# Separate Object-Lock-enabled bucket and KMS key for daily PostgreSQL
# recovery points. The host needs PutObject/GetObjectVersion only for this
# prefix plus the KMS Encrypt/Decrypt/GenerateDataKey permissions.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=investor-platform-postgres-backups
BACKUP_KMS_KEY_ID=
BACKUP_RETENTION_DAYS=35
# Used only by deploy/setup_aws.py to attach least-privilege KMS use to the
# host instance role. The KMS key policy must also trust that role.
BACKUP_KMS_KEY_ARN=

# Error tracking is target-local and opt-in. It is configured to redact
# authorization headers, cookies, request bodies, query strings, and user data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional operator webhook. Health evidence stays local; this URL receives
# only a failed-check notification without request, user, or secret data.
OPS_ALERT_WEBHOOK_URL=

# Public account lifecycle
AUTH_PUBLIC_REGISTRATION=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_EMAIL_FROM=
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=
AUTH_SEED_ROLE=user
# Optional second verified account for the mandatory two-user release smoke.
# Keep these credentials distinct from the primary seed and mirror them in the
# target-local authenticated smoke credential store.
AUTH_SECONDARY_SEED_EMAIL=
AUTH_SECONDARY_SEED_PASSWORD=
AUTH_SECONDARY_SEED_ROLE=user
RESEND_API_KEY=

# Bootstrap a durable role explicitly. Use `admin` only for the separately
# provisioned admin account; the admin API has no static password fallback.
