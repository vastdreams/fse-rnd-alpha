{
  "schema_version": 1,
  "title": "Decision chains — data-driven, fail-closed, first principles",
  "authority": "Code + sealed tests are authoritative. Precedence labels that are not hard gates are marked advisory. UNKNOWN is a product outcome, never filled with opinion.",
  "assumption_policy": {
    "imputation": "forbidden",
    "missing_input": "UNKNOWN or exclude — never invent",
    "marketing_copy": "must match engine or is a bug (see test_recipe_engine_parity)"
  },
  "chains": [
    {
      "id": "D_STANCE_BUY",
      "name": "Research BUY stance — Repriced × R&D-Validated × Survivable",
      "first_principles": "BUY is underwriting clearance, not attractiveness and not a sizing order. The thesis is the intersection of independent evidence: the validated R&D factor cohort (paper spine — the only component with published inference), a measured repricing (sealed MoS, live gap, payoff skew), and hard survivability floors (a cheap R&D name that dies never collects the premium). Every hard gate is a measurable field; any missing critical input → UNKNOWN, not a guessed BUY. Implied annualised return is gap-close maths, not a forecast. Factor evidence is cross-sectional: no per-name expected return is ever claimed.",
      "engine": "backend/app/services/close_call_service.py",
      "docs": [
        "docs/CLOSE_CALL_STANCE.md",
        "docs/FIRST_PRINCIPLES_PROVENANCE.md"
      ],
      "output_fields": [
        "stance",
        "confidence",
        "blockers",
        "flowchart",
        "implied_ann_return"
      ],
      "steps": [
        {
          "id": "F0",
          "label": "Validated-factor eligibility (RD spine)",
          "gate_kind": "hard",
          "data_fields": [
            "rd_elig",
            "rd_composite"
          ],
          "formula_ids": [
            "F_RD_COMPOSITE"
          ],
          "pass_if": "rd_elig === true",
          "fail_if": "rd_elig === false",
          "unknown_if": "rd_elig is null/missing (pre-thesis universe or unknown R&D inputs)",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Top-quintile RD composite within the sealed universe (thesis-gates.json) — proxy for the paper RD20 cohort, the only selection component backed by published inference. Cross-sectional evidence only: never a per-name return claim."
        },
        {
          "id": "F1",
          "label": "Kill criterion off",
          "gate_kind": "hard",
          "data_fields": [
            "kill_active"
          ],
          "formula_ids": [],
          "pass_if": "kill_active === false",
          "fail_if": "kill_active === true",
          "unknown_if": "kill_active is null/missing",
          "on_unknown": "block_buy",
          "opinion": false
        },
        {
          "id": "F2",
          "label": "Completeness A|B",
          "gate_kind": "hard",
          "data_fields": [
            "completeness_grade"
          ],
          "formula_ids": [],
          "pass_if": "completeness_grade ∈ {A,B}",
          "fail_if": "completeness_grade ∈ {C,Incomplete} or missing",
          "unknown_if": "grade missing",
          "on_unknown": "block_buy",
          "opinion": false
        },
        {
          "id": "F2b",
          "label": "Survivability floors",
          "gate_kind": "hard",
          "data_fields": [
            "survivable",
            "fcfm_sbc",
            "rule40",
            "runway_yrs",
            "dilution_ann",
            "retention"
          ],
          "formula_ids": [
            "F_SURVIVABILITY_FLOORS"
          ],
          "pass_if": "survivable === true",
          "fail_if": "survivable === false",
          "unknown_if": "survivable is null/missing (required floor field unknown)",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Hard floors from thesis-gates.json: cash engine (FCF+ or Rule-of-40), runway, dilution, retention. Declared judgments, not validated predictors — but a dead company collects no factor premium."
        },
        {
          "id": "F3",
          "label": "Sealed MoS > 0",
          "gate_kind": "hard",
          "data_fields": [
            "mos_live"
          ],
          "formula_ids": [
            "F_MOS_LIVE"
          ],
          "pass_if": "mos_live > 0",
          "fail_if": "mos_live ≤ 0",
          "unknown_if": "mos_live is null",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Frozen research margin of safety on the sealed vector — not live intrinsic value. Live tape is gated separately by F3b."
        },
        {
          "id": "F3b",
          "label": "Live vs-target > 0",
          "gate_kind": "hard",
          "data_fields": [
            "gap_to_median",
            "price_live",
            "fair_px_med"
          ],
          "formula_ids": [
            "F_VS_MEDIAN_PCT",
            "F_LIVE_VS_SEALED_GATE"
          ],
          "pass_if": "gap_to_median > 0",
          "fail_if": "gap_to_median ≤ 0",
          "unknown_if": "gap_to_median missing from valuation_range",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Hard underwriting gate: sealed MoS alone cannot clear BUY when the live tape has already closed (or gone through) the target gap."
        },
        {
          "id": "F3c",
          "label": "Payoff skew ≥ 3:1",
          "gate_kind": "hard",
          "data_fields": [
            "payoff_skew",
            "payoff_skew_label",
            "fair_px_lo",
            "fair_px_hi"
          ],
          "formula_ids": [
            "F_PAYOFF_SKEW"
          ],
          "pass_if": "payoff_skew ≥ 3 or payoff_skew_label === below_band",
          "fail_if": "payoff_skew < 3",
          "unknown_if": "payoff_skew null and no below_band label (band or price missing/degenerate)",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Band asymmetry (hi−P)/(P−lo) from the sealed fair band. Price at/below the low lens passes as 'below band'. The band is a model output, not market data — labeled as such."
        },
        {
          "id": "F4",
          "label": "Catalyst named (L4 known)",
          "gate_kind": "hard",
          "data_fields": [
            "L4.status",
            "dated_anchors"
          ],
          "formula_ids": [],
          "pass_if": "L4.status === known with dated anchors inside the event window",
          "fail_if": "n/a — absence is UNKNOWN not FAIL",
          "unknown_if": "L4.status !== known (no dated anchor inside peak−30d…trough+45d)",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "Will not invent news. Anchors must be dated and fall inside the tape-event window; no dated catalyst → UNKNOWN confidence."
        },
        {
          "id": "F5",
          "label": "Aggregate score ≥ 65",
          "gate_kind": "hard",
          "data_fields": [
            "roi_runs[].score",
            "roi_runs[].weight"
          ],
          "formula_ids": [
            "F_STANCE_BUY_GATES"
          ],
          "pass_if": "agg_score ≥ 65",
          "fail_if": "agg_score < 65",
          "unknown_if": "no scored ROI runs",
          "on_unknown": "block_buy",
          "opinion": false,
          "note": "agg = mean_w(scores)×10×coverage; coverage penalises missing weight mass."
        },
        {
          "id": "F6",
          "label": "Stance emit",
          "gate_kind": "hard",
          "data_fields": [
            "F0",
            "F1..F5",
            "F2b",
            "F3c",
            "confidence"
          ],
          "formula_ids": [
            "F_HOLD_HORIZON",
            "F_IMPLIED_ANN_RETURN"
          ],
          "pass_if": "all hard gates pass ∧ confidence ∈ {med,high} → BUY",
          "fail_if": "see OUT/HOLD/WATCH rules in engine",
          "unknown_if": "critical inputs unknown",
          "on_unknown": "emit_UNKNOWN",
          "opinion": false
        }
      ],
      "advisory_not_gates": [
        {
          "id": "P2_FCF",
          "label": "FCF+ check (advisory — not a BUY gate)",
          "data_fields": [
            "fcfm_sbc"
          ],
          "gate_kind": "advisory",
          "note": "Shown with ADVISORY badge in StanceTab. NOT in buy_ok. Match/fail must not be read as underwriting clearance."
        }
      ]
    },
    {
      "id": "D_RANK_R3",
      "name": "Universe R3 ranking",
      "first_principles": "Rank is a cross-sectional robust-z of disclosed axes only. Missing axis → name excluded from that recipe (never imputed). Score is attractiveness under the recipe, not a BUY clearance.",
      "engine": "backend/app/services/rank_service/engine.py",
      "docs": [
        "docs/FIRST_PRINCIPLES_PROVENANCE.md",
        "contracts/formula-registry.json#F_SCORE_ROBUST_Z"
      ],
      "output_fields": [
        "rank",
        "score",
        "contributions",
        "completeness_grade",
        "kill_active"
      ],
      "steps": [
        {
          "id": "R3_H1",
          "label": "Hard filter: not killed, not carved-out",
          "gate_kind": "hard",
          "data_fields": [
            "kill_active",
            "carve_out"
          ],
          "formula_ids": [],
          "pass_if": "kill_active==false ∧ carve_out==false",
          "fail_if": "otherwise excluded",
          "unknown_if": "n/a — boolean filters",
          "on_unknown": "exclude",
          "opinion": false
        },
        {
          "id": "R3_H2",
          "label": "Required axes present (PIT)",
          "gate_kind": "hard",
          "data_fields": [
            "rd_prod",
            "fcfm_sbc",
            "roic",
            "mos_live"
          ],
          "formula_ids": [
            "F_PASS_THROUGH_FUNDAMENTALS",
            "F_MOS_LIVE"
          ],
          "pass_if": "all four axes knowable at as_of",
          "fail_if": "any required axis None → exclude",
          "unknown_if": "axis missing or available_date > as_of",
          "on_unknown": "exclude",
          "opinion": false
        },
        {
          "id": "R3_H3",
          "label": "Weighted MAD robust-z score",
          "gate_kind": "hard",
          "data_fields": [
            "rd_prod",
            "fcfm_sbc",
            "roic",
            "mos_live"
          ],
          "formula_ids": [
            "F_SCORE_ROBUST_Z",
            "F_SCORE_WITHOUT_DRIVERS"
          ],
          "pass_if": "score = Σ w·winsor±3((x-med)/(1.4826·MAD))",
          "fail_if": "n/a",
          "unknown_if": "n/a after H2",
          "on_unknown": "n/a",
          "opinion": false,
          "weights": {
            "rd_prod": 1.5,
            "fcfm_sbc": 1.0,
            "roic": 1.0,
            "mos_live": 1.5
          }
        },
        {
          "id": "R3_H4",
          "label": "Enrich live vs-target (display)",
          "gate_kind": "derived",
          "data_fields": [
            "price_live",
            "fair_px_med"
          ],
          "formula_ids": [
            "F_VS_MEDIAN_PCT",
            "F_VS_MEDIAN_USD"
          ],
          "pass_if": "vs_median_pct = (fair_px_med - price_live) / price_live",
          "fail_if": "invariant violation",
          "unknown_if": "price or fair missing",
          "on_unknown": "null_field",
          "opinion": false
        }
      ],
      "advisory_not_gates": [
        {
          "id": "WEAVE_ATTRIBUTION",
          "label": "Factor weave attribution (ordinal ordering only)",
          "data_fields": [
            "weave_z",
            "weave_score",
            "weave_partial"
          ],
          "formula_ids": [
            "F_RD_COMPOSITE"
          ],
          "gate_kind": "advisory",
          "note": "weave_score = 0.40·z_rd + 0.25·z_quality + 0.20·z_valuation + 0.15·z_momentum (declared in thesis-gates.json, never fitted to history). Missing family contributes 0 with weave_partial=true. Ordering only — never a return claim, never a clearance."
        },
        {
          "id": "ABOVE_BAND_FLAG",
          "label": "Above fair band (Option B)",
          "data_fields": [
            "price_live",
            "fair_px_hi"
          ],
          "formula_ids": [
            "F_FAIR_BAND_ZONE"
          ],
          "gate_kind": "advisory",
          "note": "Does not exclude from R3. UI must flag. High score above band is quality/MoS axes, not a bargain claim."
        }
      ]
    },
    {
      "id": "D_SELL_CEILING",
      "name": "Auto-sell / trim ceiling",
      "first_principles": "Exit maths from the sealed fair band vs live price. Not a forecast. Horizon buckets shared with stance.",
      "engine": "frontend/src/lib/sellCeiling.ts + backend/app/services/sell_ceiling.py",
      "docs": [
        "docs/SELL_CEILING.md",
        "contracts/formula-registry.json#F_SELL_CEILING"
      ],
      "output_fields": [
        "sell_ceil",
        "zone",
        "upside_to_ceil",
        "horizon_years",
        "remaining_ann"
      ],
      "steps": [
        {
          "id": "S1",
          "label": "Band + live known",
          "gate_kind": "hard",
          "data_fields": [
            "fair_px_med",
            "price_live"
          ],
          "formula_ids": [
            "F_FAIR_BAND_ORDER"
          ],
          "pass_if": "med>0 ∧ live>0",
          "fail_if": "missing → zone=unknown",
          "unknown_if": "any required null",
          "on_unknown": "null_ceiling",
          "opinion": false
        },
        {
          "id": "S2",
          "label": "Choose ceiling lens",
          "gate_kind": "hard",
          "data_fields": [
            "price_live",
            "fair_px_med",
            "fair_px_hi"
          ],
          "formula_ids": [
            "F_SELL_CEILING"
          ],
          "pass_if": "live<med→med; med≤live<hi→hi; live≥hi→past_ceiling",
          "fail_if": "n/a",
          "unknown_if": "n/a after S1",
          "on_unknown": "n/a",
          "opinion": false
        },
        {
          "id": "S3",
          "label": "Horizon + implied ann.",
          "gate_kind": "derived",
          "data_fields": [
            "upside_to_ceil"
          ],
          "formula_ids": [
            "F_HOLD_HORIZON",
            "F_IMPLIED_ANN_RETURN"
          ],
          "pass_if": "gap buckets 0.25/0.6 → 2y/3y; ann=(ceil/live)^(1/H)-1",
          "fail_if": "past_ceiling → withhold horizon",
          "unknown_if": "upside≤0",
          "on_unknown": "null_horizon",
          "opinion": false
        }
      ],
      "advisory_not_gates": []
    },
    {
      "id": "D_FILTER_BELOW_TARGET",
      "name": "Universe filter: Below target vs Undervalued",
      "first_principles": "Two filters, two fields. Never treat them as synonyms when mos≈vs — copy must stay distinct.",
      "engine": "frontend/src/pages/portfolio/UniversePage.tsx",
      "docs": [
        "contracts/formula-registry.json#F_VS_MEDIAN_PCT"
      ],
      "output_fields": [
        "filtered_rows"
      ],
      "steps": [
        {
          "id": "FLT1",
          "label": "Below target",
          "gate_kind": "hard",
          "data_fields": [
            "vs_median_pct"
          ],
          "formula_ids": [
            "F_VS_MEDIAN_PCT"
          ],
          "pass_if": "vs_median_pct > 0",
          "fail_if": "vs_median_pct ≤ 0 or null",
          "unknown_if": "vs_median_pct null → exclude from filter",
          "on_unknown": "exclude",
          "opinion": false
        },
        {
          "id": "FLT2",
          "label": "Undervalued (frozen MoS)",
          "gate_kind": "hard",
          "data_fields": [
            "mos_live"
          ],
          "formula_ids": [
            "F_MOS_LIVE"
          ],
          "pass_if": "mos_live > 0",
          "fail_if": "mos_live ≤ 0 or null",
          "unknown_if": "mos_live null → exclude",
          "on_unknown": "exclude",
          "opinion": false
        }
      ],
      "advisory_not_gates": []
    }
  ]
}
