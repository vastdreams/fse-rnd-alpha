    {
      "id": "F_VS_MEDIAN_PCT",
      "name": "Live gap vs price target (%)",
      "expression": "(fair_px_med - price_live) / price_live",
      "surfaces": [
        "api.universe.rank",
        "universe_card.vs_target"
      ],
      "compute": [
        "backend/app/services/rank_row_invariants.py:compute_live_vs_target_pct"
      ],
      "display": [
        "frontend/src/components/research/ScreenerRow.tsx"
      ],
      "audit": [
        "backend/tests/test_rank_row_invariants.py",
        "frontend/src/lib/rankRowInvariants.test.ts",
        "frontend/src/lib/rankGolden.test.ts",
        "frontend/e2e/universe-number-parity.spec.ts"
      ],
      "reference": {
        "kind": "paper",
        "cite": "Paper-2 §6 fair-value triangulation; live tape-relative gap uses median fair px"
      },
      "status": "audited"
    },
