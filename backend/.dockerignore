# PATH: backend/.dockerignore
# PURPOSE: Exclude unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
.hypothesis/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore

# Logs
*.log
logs/

# Local development
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in container)
*.md
docs/

# Tests (not needed in production container)
tests/
conftest.py
pytest.ini


